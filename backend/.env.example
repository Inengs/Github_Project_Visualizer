GITHUB_TOKEN=
ALLOWED_ORIGINS=
DATABASE_URL=

# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the app's "Authorization callback URL", e.g. http://localhost:8000/api/auth/github/callback
GITHUB_OAUTH_CALLBACK_URL=
# SPA origin for post-login redirect (token in URL fragment). Optional; if unset, callback returns JSON only.
FRONTEND_URL=

# HS256 secret for API JWTs after OAuth (use a long random string in production)
JWT_SECRET=
# Optional; default 604800 (7 days)
# JWT_EXPIRE_SECONDS=604800

# --- Redis: GitHub API response cache (recommended for production) ---
# Example: redis://localhost:6379/0
REDIS_URL=
# Fresh cache window in seconds (clamped to 300–900 = 5–15 minutes)
# CACHE_TTL_SECONDS=600
# How long we may still return cached JSON when GitHub rate-limits us
# CACHE_STALE_MAX_SECONDS=86400

# Background refresh: after ~80% of CACHE_TTL, serve cache and refresh in background.
# Optional queue (pick one):
# ENABLE_CELERY=1
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Run: celery -A app.celery_app.celery_app worker -l info

# USE_REDIS_REFRESH_QUEUE=1
# Run: python -m app.workers.redis_refresh_worker
